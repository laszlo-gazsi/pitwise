{
  "name": "pitwise",
  "version": "0.0.0",
  "description": "PitWise - Self-hosted fuel & maintenance tracker for family vehicles - NestJS, Vue, Postgres, Keycloak, Docker.",
  "homepage": "https://github.com/laszlo-gazsi/pitwise#readme",
  "bugs": {
    "url": "https://github.com/laszlo-gazsi/pitwise/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laszlo-gazsi/pitwise.git"
  },
  "license": "MIT",
  "author": "Laszlo Gazsi",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
